{
  "name": "sqlexplorer",
  "productName": "SQLExplorer",
  "version": "0.1.0",
  "description": "Cross-platform Oracle and PostgreSQL desktop client",
  "main": ".vite/build/main.js",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "postinstall": "node scripts/ensure-electron.mjs",
    "start": "node scripts/start.mjs",
    "dev:web": "vite --host 127.0.0.1 --config vite.renderer.config.mts",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "make": "npm run package",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "node scripts/test-databases.mjs",
    "test:electron": "playwright test --config playwright.electron.config.ts",
    "test:package": "node scripts/test-package.mjs",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "author": "SQLExplorer contributors",
  "license": "MIT",
  "dependencies": {
    "oracledb": "7.0.1",
    "pg": "8.23.0",
    "pg-cursor": "2.22.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/oracledb": "7.0.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/pg-cursor": "2.7.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "electron": "44.3.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "lucide-react": "1.43.0",
    "monaco-editor": "0.56.0",
    "react": "19.2.8",
    "react-data-grid": "7.0.0-beta.61",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "oracledb@7.0.1": true
  },
  "overrides": {
    "dompurify": "3.4.15"
  }
}
